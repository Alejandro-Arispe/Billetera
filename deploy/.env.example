# Configuración de producción. deploy/setup-vm.sh la copia a deploy/.env y reemplaza los __VALORES__
# por secretos aleatorios. Nunca subas deploy/.env a git.
APP_NAME=Billetera
DOMAIN=__DOMAIN__
PAY_BASE_URL=https://__DOMAIN__

# Base de datos (contenedor postgres). DB_SYNC=true crea/actualiza las tablas al arrancar.
DB_USER=billetera
DB_PASSWORD=__DB_PASSWORD__
DB_SYNC=true
AUTH_DB_NAME=auth_db
WALLET_DB_NAME=wallet_db
CARD_DB_NAME=card_db
PAYMENTS_DB_NAME=payments_db
KYC_DB_NAME=kyc_db
RABBITMQ_PASSWORD=__RABBITMQ_PASSWORD__

GATEWAY_PORT=4000
AUTH_PORT=3001
WALLET_PORT=3002
PAYMENTS_PORT=3003
CARD_PORT=3004
KYC_PORT=3005
NOTIFICATION_PORT=3006

JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
OTP_SECRET=__OTP_SECRET__
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
INTERNAL_API_KEY=__INTERNAL_API_KEY__

# Correo. Por defecto va a Mailpit (bandeja en https://DOMINIO/correo/).
# Para que el código de registro llegue al correo real, usa un SMTP (Gmail con contraseña de
# aplicación, Brevo, Resend, Azure Communication Services…), por ejemplo:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=tucuenta@gmail.com  SMTP_PASSWORD=<app password>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Billetera <no-reply@billetera.local>
MAILPIT_UI_AUTH=__MAILPIT_UI_AUTH__

FX_RATES_URL=https://open.er-api.com/v6/latest/USD
FX_SPREAD=0.015
MAX_TOPUP_AMOUNT=5000

CARD_ENCRYPTION_KEY=__CARD_ENCRYPTION_KEY__
CARD_BIN=40000012
CARD_REQUIRE_KYC=true
# API keys de los sistemas que pueden cobrar con la tarjeta virtual (separadas por coma)
CARD_ACQUIRER_API_KEYS=__CARD_ACQUIRER_KEY__

QR_SIGNING_SECRET=__QR_SIGNING_SECRET__

KYC_ENCRYPTION_KEY=__KYC_ENCRYPTION_KEY__
KYC_AUTO_APPROVE=false

ADMIN_EMAIL=admin@billetera.local
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# POS de demostración (https://DOMINIO:8443)
POS_PORT=5000
POS_STORE_NAME=Cafetería Demo
POS_CURRENCY=BOB
POS_CARD_ACQUIRER_KEY=__CARD_ACQUIRER_KEY__
POS_MERCHANT_EMAIL=cafeteria.demo@billetera.local
POS_MERCHANT_PASSWORD=CafeDemo2026
POS_API_KEY=
POS_WEBHOOK_SECRET=
DEMO_CUSTOMER_EMAIL=cliente.demo@billetera.local
DEMO_CUSTOMER_PASSWORD=ClienteDemo2026
DEMO_CUSTOMER_PIN=2468
