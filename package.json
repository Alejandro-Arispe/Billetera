{
  "name": "billetera",
  "version": "0.1.0",
  "description": "Billetera digital simulada con pagos QR tipo POS, construida con microservicios NestJS",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build api-gateway && nest build auth-service && nest build notification-service && nest build wallet-service && nest build card-service && nest build payments-service && nest build kyc-service && nest build pos-demo && npm run app:build && npm run sdk:build",
    "infra:up": "docker compose up -d postgres redis rabbitmq mailpit",
    "infra:down": "docker compose down",
    "dev": "concurrently -n gateway,auth,notif,wallet,card,payments,kyc,pos -c cyan,green,magenta,yellow,blue,red,gray,white \"npm:start:gateway\" \"npm:start:auth\" \"npm:start:notification\" \"npm:start:wallet\" \"npm:start:card\" \"npm:start:payments\" \"npm:start:kyc\" \"npm:start:pos\"",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:wallet": "nest start wallet-service --watch",
    "start:card": "nest start card-service --watch",
    "start:payments": "nest start payments-service --watch",
    "start:kyc": "nest start kyc-service --watch",
    "start:pos": "nest start pos-demo --watch",
    "app:dev": "vite --config apps/wallet-app/vite.config.ts",
    "app:build": "vite build --config apps/wallet-app/vite.config.ts",
    "app:icons": "node scripts/gen-icons.mjs",
    "sdk:build": "tsc -p packages/sdk/tsconfig.json",
    "pos:setup": "node scripts/setup-pos.mjs",
    "smoke": "node scripts/smoke-auth.mjs && node scripts/smoke-wallet.mjs && node scripts/smoke-payments.mjs && node scripts/smoke-kyc.mjs && node scripts/smoke-admin.mjs",
    "smoke:wallet": "node scripts/smoke-wallet.mjs",
    "smoke:payments": "node scripts/smoke-payments.mjs",
    "smoke:kyc": "node scripts/smoke-kyc.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^11.0.3",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "http-proxy-middleware": "^3.0.11",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "ts-loader": "^9.6.2",
    "typescript": "~5.8",
    "vite": "^5.4.11"
  }
}
